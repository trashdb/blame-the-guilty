<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Statefalse.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Statefalse.Api.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Statefalse.Application/Statefalse.Application.csproj" />
    <ProjectReference Include="Statefalse.Infrastructure/Statefalse.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Statefalse.Application/**/*.cs" />
    <Compile Remove="Statefalse.Domain/**/*.cs" />
    <Compile Remove="Statefalse.Infrastructure/**/*.cs" />
    <Content Remove="Statefalse.Application/**/*" />
    <Content Remove="Statefalse.Domain/**/*" />
    <Content Remove="Statefalse.Infrastructure/**/*" />
    <EmbeddedResource Remove="Statefalse.Application/**/*" />
    <EmbeddedResource Remove="Statefalse.Domain/**/*" />
    <EmbeddedResource Remove="Statefalse.Infrastructure/**/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pin transitives to patched versions (GHSA-v5pm-xwqc-g5wc, GHSA-2m69-gcr7-jv3q) -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

</Project>
